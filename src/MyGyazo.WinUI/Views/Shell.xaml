<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid.Resources>
    <Style x:Key="Description" TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
  </Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="*" /></Grid.RowDefinitions>
  <Grid x:Name="TitleBar" Background="Transparent" Padding="12,0,140,0">
    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
      <FontIcon Glyph="&#xE722;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
      <TextBlock Text="My Gyazo" FontWeight="SemiBold" VerticalAlignment="Center" />
    </StackPanel>
  </Grid>
  <NavigationView x:Name="Navigation" Grid.Row="1" IsBackButtonVisible="Collapsed" IsSettingsVisible="True" OpenPaneLength="180" PaneDisplayMode="Auto" ExpandedModeThresholdWidth="1100" CompactModeThresholdWidth="700" IsPaneToggleButtonVisible="True">
    <NavigationView.MenuItems><NavigationViewItem x:Name="LibraryNavigation" Content="Capture library" Tag="library"><NavigationViewItem.Icon><SymbolIcon Symbol="Pictures" /></NavigationViewItem.Icon></NavigationViewItem></NavigationView.MenuItems>
    <Grid Padding="12,8,12,12">
      <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid x:Name="LibraryPage" ColumnSpacing="12">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="LibraryColumn" Width="260" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Grid RowSpacing="8">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <TextBox x:Name="SearchBox" PlaceholderText="Search captures" AutomationProperties.Name="Search by filename or date" />
          <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <DropDownButton x:Name="SortButton" HorizontalAlignment="Left" AutomationProperties.Name="Sort captures">
              <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8CB;" FontSize="14" /><TextBlock x:Name="SortLabel" Text="Newest first" /></StackPanel>
              <DropDownButton.Flyout><MenuFlyout>
                <RadioMenuFlyoutItem x:Name="NewestSortItem" Text="Newest first" GroupName="CaptureSort" IsChecked="True" />
                <RadioMenuFlyoutItem x:Name="OldestSortItem" Text="Oldest first" GroupName="CaptureSort" />
              </MenuFlyout></DropDownButton.Flyout>
            </DropDownButton>
            <Button x:Name="RefreshButton" Grid.Column="1" AutomationProperties.Name="Refresh library" ToolTipService.ToolTip="Refresh library"><SymbolIcon Symbol="Refresh" /></Button>
          </Grid>
          <ListView x:Name="CaptureList" Grid.Row="2" SelectionMode="Single" IsItemClickEnabled="False" AutomationProperties.Name="Capture library" HorizontalContentAlignment="Stretch">
            <ListView.ItemTemplate><DataTemplate>
              <Grid Padding="0,4" ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="56" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Image Source="{Binding Thumbnail}" Width="56" Height="40" Stretch="Uniform" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4"><TextBlock Text="{Binding DisplayDate}" FontWeight="SemiBold" FontSize="13" /><TextBlock Text="{Binding DisplayTime}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
              </Grid>
            </DataTemplate></ListView.ItemTemplate>
          </ListView>
        </Grid>
        <Border Grid.Column="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <Grid Grid.Column="2">
          <Grid x:Name="PreviewPanel" RowSpacing="8">
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid>
              <Image x:Name="PreviewImage" Stretch="Uniform" AutomationProperties.Name="Selected screenshot" />
              <TextBlock x:Name="PreviewError" Style="{StaticResource Description}" TextAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <CommandBar x:Name="ImageActions" Grid.Row="1" DefaultLabelPosition="Right" OverflowButtonVisibility="Auto" Background="Transparent" HorizontalAlignment="Stretch">
              <AppBarButton x:Name="CopyButton" Icon="Copy" Label="Copy" ToolTipService.ToolTip="Copy image" />
              <AppBarButton x:Name="OpenButton" Icon="OpenFile" Label="Open" />
              <AppBarButton x:Name="RevealButton" Icon="Folder" Label="Show in folder" />
              <AppBarButton x:Name="DeleteButton" Icon="Delete" Label="Delete" />
            </CommandBar>
          </Grid>
          <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="300">
            <TextBlock x:Name="EmptyTitle" Text="No captures yet" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" />
            <TextBlock x:Name="EmptyDescription" Style="{StaticResource Description}" TextAlignment="Center" />
          </StackPanel>
        </Grid>
      </Grid>
      <Grid x:Name="SettingsPage" Visibility="Collapsed" MaxWidth="760" HorizontalAlignment="Left" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Settings" Style="{ThemeResource TitleTextBlockStyle}" /></StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="12" Padding="0,0,4,4">
          <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,16"><StackPanel Spacing="8">
            <StackPanel Spacing="4"><TextBlock Text="Capture folder" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="Every screenshot is saved here as a PNG." Style="{StaticResource Description}" /></StackPanel>
            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="FolderBox" AutomationProperties.Name="Capture folder" /><Button x:Name="BrowseButton" Grid.Column="1" Content="Browse…" /></Grid>
            <TextBlock Text="Changing folders leaves previous captures where they are." FontSize="12" Style="{StaticResource Description}" />
          </StackPanel></Border>
          <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,16"><StackPanel Spacing="8">
            <StackPanel Spacing="4"><TextBlock Text="Keyboard shortcut" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="Start a capture from anywhere on your desktop." Style="{StaticResource Description}" /></StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12"><CheckBox x:Name="CtrlBox" Content="Ctrl" MinWidth="0" /><CheckBox x:Name="ShiftBox" Content="Shift" MinWidth="0" /><CheckBox x:Name="AltBox" Content="Alt" MinWidth="0" /><TextBlock Text="+" VerticalAlignment="Center" /><ComboBox x:Name="KeyBox" Width="88" DisplayMemberPath="Label" SelectedValuePath="Value" AutomationProperties.Name="Shortcut key" /></StackPanel>
          </StackPanel></Border>
          <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,16"><StackPanel Spacing="8">
            <TextBlock Text="Ready when you are" FontSize="18" FontWeight="SemiBold" />
            <ToggleSwitch x:Name="StartupSwitch" Header="Launch when I sign in" OffContent="Start manually" OnContent="Start in the system tray" />
            <TextBlock Text="Keep the app in a permanent folder before enabling launch at login." FontSize="12" Style="{StaticResource Description}" />
          </StackPanel></Border>
        </StackPanel></ScrollViewer>
        <StackPanel Grid.Row="2" Spacing="8">
          <InfoBar x:Name="SettingsError" Severity="Error" IsOpen="False" IsClosable="True" Title="Check your settings" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"><Button x:Name="CancelSettingsButton" Content="Cancel" /><Button x:Name="SaveSettingsButton" Content="Save changes" Style="{ThemeResource AccentButtonStyle}" /></StackPanel>
        </StackPanel>
      </Grid>
      <InfoBar x:Name="StatusBar" Grid.Row="1" IsOpen="False" IsClosable="True" Margin="0,12,0,0" />
    </Grid>
  </NavigationView>
</Grid>
